pipeline {
	agent none
	stages {
		stage('backend') {
			agent {
				docker {image 'node:current-alpine3.23'}
			}
			steps {
				echo "stage: backend"
				sh 'npm --version'
			}
		}
		
		stage('db') {
			agent {
				docker {image 'mysql:oraclelinux9'}
			}
			steps {
				echo "stage: db"
				sh 'mysql --version'
			}
		}
	}
}
